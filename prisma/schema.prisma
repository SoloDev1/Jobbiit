generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  MEMBER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum Platform {
  IOS
  ANDROID
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  VOLUNTEER
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  POST_COMMENT
  JOB_APPLICATION
  JOB_MATCH
  PROFILE_VIEW
  OPPORTUNITY_MATCH
  OPPORTUNITY_EXPIRING
  SYSTEM

  JOB_LIKE
  JOB_COMMENT
  OPPORTUNITY_LIKE
  OPPORTUNITY_COMMENT
}

enum OpportunityStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  REJECTED
  ARCHIVED
}

enum OpportunityCategory {
  JOB
  SCHOLARSHIP
  FELLOWSHIP
  INTERNSHIP
  GRANT
  COMPETITION
  VOLUNTEER
  MENTORSHIP      // ← add
  CONFERENCE      // ← add
  ACCELERATOR     // ← add
  TRAINING        // ← add
  VISA
  AWARD      
  OTHER
}

enum ExperienceLevel {
  STUDENT
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR
  EXECUTIVE
  ANY
}


enum SourceType {
  ADMIN
  MODERATOR
  SCRAPER
  PARTNER
}

enum UserEventType {
  VIEW_OPPORTUNITY
  SAVE_OPPORTUNITY
  UNSAVE_OPPORTUNITY
  APPLY_OPPORTUNITY
  CLICK_NOTIFICATION
  SEARCH
  VIEW_PROFILE
}

enum AuditAction {
  CREATE_OPPORTUNITY
  UPDATE_OPPORTUNITY
  DELETE_OPPORTUNITY
  APPROVE_OPPORTUNITY
  REJECT_OPPORTUNITY
  BAN_USER
  UNBAN_USER
  CHANGE_ROLE
  DELETE_POST
  DELETE_COMMENT
  RESOLVE_REPORT
  DISMISS_REPORT
  DELETE_JOB 
  HARD_DELETE_JOB
  HARD_DELETE_OPPORTUNITY

  // Auth & account lifecycle
  SIGNUP
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  OAUTH_SIGNIN_EXISTING
  OAUTH_SIGNIN_NEW
  REFRESH_TOKEN_REUSE
  ACCOUNT_DELETED
  ACCOUNT_DELETED_OAUTH

  // Password recovery
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_OTP_REQUESTED
  PASSWORD_OTP_VERIFY_SUCCESS
  PASSWORD_OTP_VERIFY_FAILED

  // User-driven content & moderation
  JOB_CREATED
  JOB_UPDATED
  JOB_CLOSED
  REPORT_CREATED

  // Admin messaging
  ADMIN_PUSH_SENT
  ADMIN_NOTIFICATION_SENT

  // User important actions
  ONBOARDING_COMPLETED
  DOCUMENT_GENERATED
  CHAT_STARTED
  OPPORTUNITY_SAVED
  OPPORTUNITY_APPLIED
}

enum AuditLogStatus {
  SUCCESS
  FAILURE
}

enum ReportType {
  POST
  COMMENT
  USER
  JOB
  OPPORTUNITY
  JOB_COMMENT         
  OPPORTUNITY_COMMENT 
}

enum ReportReason {
  SPAM
  HATE_SPEECH
  MISINFORMATION
  HARASSMENT
  INAPPROPRIATE_CONTENT
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  role         Role     @default(MEMBER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  isBanned     Boolean  @default(false)
  banReason               String?
  pushToken               String?
  onboardingCompletedAt DateTime?
  otp                   String?
  otpExpiresAt          DateTime? @map("otp_expires_at")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  jobLikes            JobLike[]
  jobComments         JobComment[]
  opportunityLikes    OpportunityLike[]
  opportunityComments OpportunityComment[]

  oauthAccounts  OAuthAccount[]

  refreshTokens       RefreshToken[]
  profile             Profile?
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  sentConnections     Connection[]             @relation("ConnectionSender")
  receivedConnections Connection[]             @relation("ConnectionReceiver")
  jobsPosted          Job[]                    @relation("JobPoster")
  applications        Application[]
  savedJobs           SavedJob[]
  opportunitiesPosted Opportunity[]            @relation("OpportunityPoster")
  opportunityReviewed Opportunity[]            @relation("OpportunityReviewer")
  savedOpportunities  SavedOpportunity[]
  opportunityApps     OpportunityApplication[]
  interests           UserInterest[]
  recommendations     Recommendation[]
  events              UserEvent[]
  notifications       Notification[]           @relation("NotificationRecipient")
  triggered           Notification[]           @relation("NotificationTrigger")
  reportsFiled        Report[]                 @relation("ReportFiler")
  reportsResolved     Report[]                 @relation("ReportResolver")
  reportsAgainst      Report[]                 @relation("ReportedUser")
  auditLogsActed      AuditLog[]               @relation("AuditActor")
  auditLogsTarget     AuditLog[]               @relation("AuditTarget")
  pushTokenRecord     PushToken?               @relation("UserPushToken")
  passwordResetTokens PasswordResetToken[]
  generatedDocuments  GeneratedDocument[]
  chatSessions        ChatSession[]
  workspaces          Workspace[]

  userMemory           UserMemory?
  userPreference       UserPreference?
  resumeDocuments      ResumeDocument[]
  coverLetterDocuments CoverLetterDocument[]
  tokenUsageLogs       TokenUsageLog[]
  aiRecommendations    AIRecommendation[]
  interviewSessions    InterviewSession[]
  flashcards           Flashcard[]

  @@index([role])
}

// ─────────────────────────────────────────
// PUSH (Expo)
// ─────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("UserPushToken", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// PROFILE
// ─────────────────────────────────────────

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  headline  String?
  bio       String?
  avatarUrl String?
  bannerUrl String?
  location  String?
  website   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // CV Upload fields
  cvUrl     String?
  cvKey     String?
  cvName    String?
  cvText    String?

  experiences Experience[]
  educations  Education[]
  skills      ProfileSkill[]
}

model Experience {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())

  @@index([profileId])
}

model Education {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school      String
  degree      String?
  field       String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())

  @@index([profileId])
}

// ─────────────────────────────────────────
// SKILLS + INTERESTS
// ─────────────────────────────────────────

model Skill {
  id            String             @id @default(uuid())
  name          String             @unique
  profiles      ProfileSkill[]
  opportunities OpportunitySkill[]
  jobs          JobSkill[]
}

model ProfileSkill {
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId],   references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

model UserInterest {
  userId          String
  category        OpportunityCategory
  experienceLevel ExperienceLevel?    // optional: "I want SENIOR opportunities in this category"
  createdAt       DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@index([userId])
}

// ─────────────────────────────────────────
// CONNECTIONS
// ─────────────────────────────────────────

model Connection {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("ConnectionSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

// ─────────────────────────────────────────
// POSTS, COMMENTS, LIKES
// ─────────────────────────────────────────

model Post {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  mediaUrls   String[] @default([])
  isDeleted   Boolean  @default(false)
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments Comment[]
  likes    Like[]
  reports  Report[]

  @@index([authorId])
  @@index([createdAt])
  @@index([isDeleted])
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  authorId    String
  content     String
  isDeleted   Boolean  @default(false)
  deletedById String?
  createdAt   DateTime @default(now())

  post    Post     @relation(fields: [postId],   references: [id], onDelete: Cascade)
  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([postId])
  @@index([authorId])
}

model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

// ─────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────

model Report {
  id              String       @id @default(uuid())
  filerId         String
  type            ReportType
  postId          String?
  commentId       String?
  reportedUserId  String?
  jobId           String?
  opportunityId   String?
  reason          ReportReason
  details         String?
  status          ReportStatus @default(PENDING)
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime     @default(now())

  jobCommentId         String?
  opportunityCommentId String?

  filer          User         @relation("ReportFiler",    fields: [filerId],        references: [id], onDelete: Cascade)
  post           Post?        @relation(fields: [postId],                           references: [id], onDelete: SetNull)
  comment        Comment?     @relation(fields: [commentId],                        references: [id], onDelete: SetNull)
  reportedUser   User?        @relation("ReportedUser",   fields: [reportedUserId], references: [id], onDelete: SetNull)
  job            Job?         @relation(fields: [jobId],                          references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId],                 references: [id], onDelete: SetNull)
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById],   references: [id], onDelete: SetNull)

  jobComment         JobComment?         @relation(fields: [jobCommentId],         references: [id], onDelete: SetNull)
  opportunityComment OpportunityComment? @relation(fields: [opportunityCommentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([filerId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// JOBS
// ─────────────────────────────────────────

model Job {
  id           String    @id @default(uuid())
  posterId     String
  poster       User      @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)
  title        String
  company      String
  location     String?
  isRemote     Boolean   @default(false)
  type         JobType   @default(FULL_TIME)
  status       JobStatus @default(OPEN)
  description  String
  requirements String?
  salary       String?
  salaryMin    Int?
  salaryMax    Int?
  currency     String?   @default("USD")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt  DateTime?

  likes    JobLike[]
  comments JobComment[]

  applications Application[]
  savedBy      SavedJob[]
  reports      Report[]
  skills       JobSkill[]

  @@index([posterId])
  @@index([status])
  @@index([createdAt])
}

model JobSkill {
  jobId   String
  skillId String
  job     Job   @relation(fields: [jobId],   references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  applicantId String
  status      ApplicationStatus @default(APPLIED)
  coverLetter String?
  resumeUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job  @relation(fields: [jobId],       references: [id], onDelete: Cascade)
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
}

model SavedJob {
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId],  references: [id], onDelete: Cascade)

  @@id([userId, jobId])
}

// ─────────────────────────────────────────
// OPPORTUNITIES
// ─────────────────────────────────────────

model OpportunitySource {
  id            String        @id @default(uuid())
  name          String
  type          SourceType
  url           String?
  createdAt     DateTime      @default(now())
  opportunities Opportunity[]
}

model Opportunity {
  id              String              @id @default(uuid())
  posterId        String
  reviewedById    String?
  sourceId        String?
  title           String
  description     String
  organisation    String
  logoUrl         String?
  blurhash        String?
  category        OpportunityCategory
  location        String?
  isRemote        Boolean             @default(false)
  experienceLevel ExperienceLevel?     
  deadline        DateTime
  applyUrl        String
  status          OpportunityStatus   @default(DRAFT)
  rejectionReason String?
  salary          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt  DateTime?


  likes    OpportunityLike[]
  comments OpportunityComment[]

  poster          User               @relation("OpportunityPoster",   fields: [posterId],     references: [id], onDelete: Cascade)
  reviewedBy      User?              @relation("OpportunityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  source          OpportunitySource? @relation(fields: [sourceId],    references: [id], onDelete: SetNull)
  skills          OpportunitySkill[]
  savedBy         SavedOpportunity[]
  applications    OpportunityApplication[]
  recommendations Recommendation[]
  events          UserEvent[]
  reports         Report[]
  analysis        OpportunityAnalysis?
  intelligence    OpportunityIntelligence?
  interviewSessions InterviewSession[]
  flashcards        Flashcard[]

  @@index([posterId])
  @@index([status])
  @@index([category])
  @@index([deadline])
  @@index([createdAt])
}

model OpportunitySkill {
  opportunityId String
  skillId       String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId],       references: [id], onDelete: Cascade)

  @@id([opportunityId, skillId])
}

model SavedOpportunity {
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId],        references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([userId, opportunityId])
}

model OpportunityApplication {
  id            String            @id @default(uuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(APPLIED)
  coverNote     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId],        references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

// ─────────────────────────────────────────
// RECOMMENDATIONS + EVENTS
// ─────────────────────────────────────────

model Recommendation {
  userId        String
  opportunityId String
  score         Float
  updatedAt     DateTime    @updatedAt

  user        User        @relation(fields: [userId],        references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([userId, opportunityId])
  @@index([userId, score])
}

model UserEvent {
  id            String        @id @default(uuid())
  userId        String
  opportunityId String?
  type          UserEventType
  metadata      Json?
  createdAt     DateTime      @default(now())

  user        User         @relation(fields: [userId],        references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([createdAt])
  @@index([opportunityId])
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  triggerId   String?
  type        NotificationType
  entityId    String?
  message     String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  trigger   User? @relation("NotificationTrigger",   fields: [triggerId],   references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([isRead])
  @@index([triggerId])
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id           String         @id @default(uuid())
  actorId      String?
  targetId     String?
  action       AuditAction
  entityId     String?
  entityType   String?
  metadata     Json?
  status       AuditLogStatus @default(SUCCESS)
  errorMessage String?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  method       String?
  path         String?
  createdAt    DateTime       @default(now())

  actor  User? @relation("AuditActor",  fields: [actorId],  references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([entityType])
  @@index([status])
  @@index([requestId])
  @@index([createdAt])
  @@index([action, createdAt])
}

// ─── JOB LIKES & COMMENTS ─────────────────────────────────────────────────────

model JobLike {
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId],  references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId])
}

model JobComment {
  id          String   @id @default(uuid())
  jobId       String
  authorId    String
  content     String
  isDeleted   Boolean  @default(false)
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job     Job      @relation(fields: [jobId],     references: [id], onDelete: Cascade)
  author  User     @relation(fields: [authorId],  references: [id], onDelete: Cascade)
  reports Report[]

  @@index([jobId])
  @@index([authorId])
}

// ─── OPPORTUNITY LIKES & COMMENTS ─────────────────────────────────────────────

model OpportunityLike {
  userId        String
  opportunityId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId],        references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([userId, opportunityId])
  @@index([opportunityId])
}

model OpportunityComment {
  id            String   @id @default(uuid())
  opportunityId String
  authorId      String
  content       String
  isDeleted     Boolean  @default(false)
  deletedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId],      references: [id], onDelete: Cascade)
  reports     Report[]

  @@index([opportunityId])
  @@index([authorId])
}

model OAuthAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "google" | "apple"
  subject    String   // the provider's user ID (sub claim)
  email      String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

// ─── AI GENERATED DOCUMENTS ───────────────────────────────────────────────────

model GeneratedDocument {
  id             String         @id @default(uuid())
  userId         String
  type           DocumentType
  format         DocumentFormat
  status         DocStatus      @default(PROCESSING)
  pdfUrl         String?
  docxUrl        String?
  r2PdfKey       String?        // R2 object key for deletion
  r2DocxKey      String?
  metadata       Json?          // store the input data
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces     WorkspaceDocument[]
  retryCount     Int            @default(0)
  errorMessage   String?
  lastAccessedAt DateTime?
  expiresAt      DateTime?      // set to createdAt + 30 days on creation

  @@index([userId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([expiresAt])
  @@index([lastAccessedAt])
}

enum DocumentType {
  CV
  COVER_LETTER
  GRANT
  SCHOLARSHIP
  SOP
  VISA
  PORTFOLIO
}

enum DocumentFormat {
  PDF
  DOCX
  BOTH
}

enum DocStatus {
  PROCESSING
  DONE
  FAILED
}

// ─── AI CHATBOT ───────────────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  mode      ChatMode      @default(GENERAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mode])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  sender    MessageRole
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ChatMode {
  GENERAL
  CV_REVIEW
  COVER_LETTER
  INTERVIEW_COACH
  CAREER_ADVISER
  SKILLS_GAP
  OPPORTUNITY_INTEL
  JOB_MATCHER
  SCHOLARSHIP_FINDER
  GRANT_FINDER
  VISA_ADVISER
  MENTORSHIP_RECOMMENDATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  title        String
  description  String
  type         String   // "cv", "cover_letter", "grant", "scholarship"
  style        String   // maps to backend PDF layout branch
  category     String   // "corporate", "modern", "simple", "creative"
  accent       String   @default("#0066cc")
  bestFor      String?
  features     String[]
  prefill      Json?
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── AI CAREER OPERATING SYSTEM MODELS ────────────────────────────────────────

model UserMemory {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topAchievements Json?    // Array of verified metric bullet points
  targetRoles     String[] @default([])
  targetIndustries String[] @default([])
  skillsSummary   String[] @default([])
  careerGoals     String?
  salaryExpectation String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredTone    String   @default("EXECUTIVE") // EXECUTIVE, CONCISE, TECHNICAL, CREATIVE
  resumeLength     String   @default("ONE_PAGE")  // ONE_PAGE, TWO_PAGES
  activeTemplateId String?
  autoTailorEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ResumeDocument {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String            @default("Untitled Resume")
  targetRole       String?
  activeVersionId  String?
  activeTemplateId String            @default("modern")
  structuredJson   Json              // Structured JSON representation of CV
  isMaster         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions         DocumentVersion[]

  @@index([userId])
  @@index([userId, isMaster])
}

model CoverLetterDocument {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String            @default("Untitled Cover Letter")
  targetCompany    String?
  targetRole       String?
  structuredJson   Json              // Structured JSON content (intro, body, conclusion)
  activeVersionId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions         DocumentVersion[]

  @@index([userId])
}

model DocumentVersion {
  id              String               @id @default(uuid())
  resumeId        String?
  coverLetterId   String?
  resume          ResumeDocument?      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  coverLetter     CoverLetterDocument? @relation(fields: [coverLetterId], references: [id], onDelete: Cascade)
  versionTag      String               // e.g. "v1.0", "v1.1", "Google-Tailored"
  jsonSnapshot    Json
  changeSummary   String?
  parentVersionId String?
  createdAt       DateTime             @default(now())

  @@index([resumeId])
  @@index([coverLetterId])
  @@index([createdAt])
}

model WorkflowSpec {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  stepsJson   Json     // Array of step definitions for multi-agent execution
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TokenUsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent       String   // e.g. "RESUME_IMPROVE_SUMMARY", "COVER_LETTER_WRITE"
  modelUsed    String   // e.g. "gpt-4o-mini", "gpt-4o"
  promptTokens Int
  completionTokens Int
  totalTokens  Int
  estimatedCostUsd Float
  latencyMs    Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AIRecommendation {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "JOB_MATCH", "RESUME_OUTDATED", "SKILL_GAP", "CERTIFICATION"
  title         String
  description   String
  actionRoute   String?
  actionMetadata Json?
  isDismissed   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, isDismissed])
}

model OpportunityAnalysis {
  id                 String      @id @default(uuid())
  opportunityId      String      @unique
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  summary            String
  simpleExplanation  String
  requiredSkills     String[]    @default([])
  preferredSkills    String[]    @default([])
  responsibilities   String[]    @default([])
  benefits           String[]    @default([])
  atsKeywords        String[]    @default([])
  interviewQuestions String[]    @default([])
  careerLevel        String?
  generatedAt        DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model OpportunityIntelligence {
  id                    String              @id @default(uuid())
  opportunityId         String              @unique
  opportunity           Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  // Modular JSON Payloads
  overview              Json                // Executive summary, whoShouldApply, whoShouldNotApply, urgency, competition
  skills                Json                // Required, preferred, technical, soft, leadership, experience, education
  ats                   Json                // Keywords, priority keywords, hidden keywords, resume/CL suggestions
  interview             Json                // Behavioral, technical, system design, leadership questions
  recommendation        Json                // Decision (Apply Immediately, Prepare More), health score, reason
  categoryData          Json?               // Scholarship/Grant fields (funding, living stipend, travel, reporting)
  
  // Granular Confidence & Quality Metrics
  sectionConfidence     Json                // { summary: 0.97, skills: 0.95, ats: 0.99, interview: 0.88 }
  overallHealthScore    Float               @default(90.0)
  
  // Versioning & Prompt Registry Tracking
  schemaVersion         String              @default("2.0")
  promptVersion         String              @default("job_v1")
  promptCategory        OpportunityCategory @default(JOB)
  aiProvider            String              @default("OpenAI")
  aiModel               String              @default("gpt-4o-mini")
  
  // Audit & Cost Telemetry
  generationReason      String              @default("INITIAL") // INITIAL, PROMPT_UPDATED, VALIDATION_FAILED, MANUAL_REFRESH
  latencyMs             Int                 @default(0)
  tokenUsageId          String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([opportunityId])
  @@index([schemaVersion])
}

enum WorkspaceStatus {
  DRAFT
  ANALYZING
  READY
  EDITING
  TAILORING
  REVIEWING
  SUBMITTED
  ARCHIVED
}

model Workspace {
  id                 String              @id @default(uuid())
  userId             String
  title              String
  status             WorkspaceStatus     @default(DRAFT)
  opportunityContext Json?
  intelligence       Json?
  preferences        Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          WorkspaceDocument[]

  @@index([userId])
  @@index([status])
}

model WorkspaceDocument {
  id          String            @id @default(uuid())
  workspaceId String
  documentId  String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, documentId])
  @@index([documentId])
}

enum InterviewPersona {
  FRIENDLY_HR
  HIRING_MANAGER
  TECHNICAL_LEAD
  FAANG_INTERVIEWER
  CEO_FOUNDER
}

enum InterviewSourceType {
  OPPORTUNITY
  CUSTOM_TEXT
  CUSTOM_URL
  CUSTOM_FILE
  CUSTOM_EMAIL
  PRACTICE
}

enum PracticeCategory {
  BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
  LEADERSHIP
  COMMUNICATION
  PRODUCT
  HR
  GRADUATE
  VISA
  SCHOLARSHIP
}

model UserStory {
  id           String   @id @default(uuid())
  userId       String
  title        String
  situation    String   @db.Text
  task         String   @db.Text
  action       String   @db.Text
  result       String   @db.Text
  metrics      String[] @default([])
  technologies String[] @default([])
  tags         String[] @default([])
  createdAt    DateTime @default(now())

  @@index([userId])
}

model InterviewSession {
  id               String              @id @default(uuid())
  userId           String
  sourceType       InterviewSourceType @default(OPPORTUNITY)
  opportunityId    String?
  rawInputText     String?             @db.Text
  sourceUrl        String?
  extractedCompany String?
  extractedRole    String?
  extractedLevel   String?
  practiceCategory PracticeCategory?
  persona          InterviewPersona    @default(HIRING_MANAGER)
  difficulty       String              @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  readinessScore   Int                 @default(75)
  starScore        Int                 @default(80)
  sessionReplay    Json?
  conversationState Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity      Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  feedbacks        InterviewFeedback[]

  @@index([userId])
  @@index([opportunityId])
  @@index([sourceType])
}

model InterviewFeedback {
  id            String           @id @default(uuid())
  sessionId     String
  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText  String
  answerText    String
  situationOk   Boolean          @default(true)
  taskOk        Boolean          @default(true)
  actionOk      Boolean          @default(false)
  resultOk      Boolean          @default(false)
  metricsFound  Boolean          @default(false)
  score         Int              @default(70)
  coachingTip   String
  improvedAnswer String
  createdAt     DateTime         @default(now())

  @@index([sessionId])
}

model Flashcard {
  id             String       @id @default(uuid())
  userId         String
  opportunityId  String?
  question       String
  expectedAnswer String
  commonMistakes String[]     @default([])
  strongKeywords String[]     @default([])
  previousAnswer String?
  improvedAnswer String?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([opportunityId])
}